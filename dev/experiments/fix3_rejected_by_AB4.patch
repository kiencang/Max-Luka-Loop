+def _draw_plot(page: pymupdf.Page, frame: pymupdf.Rect) -> None:
+    shape = page.new_shape()
+    shape.draw_rect(frame)
+    step = frame.width / 20
+    shape.draw_polyline([pymupdf.Point(frame.x0 + i * step, frame.y1 - 10 - (i * i) % (frame.height - 20)) for i in range(21)])
+    for i in range(12):
+        shape.draw_circle(pymupdf.Point(frame.x0 + 15 + i * (frame.width - 30) / 11, frame.y0 + 30 + (i % 4) * 25), 3)
+    shape.finish(color=(0, 0, 0), width=0.8)
+    shape.commit()
+
+
+class TestLabelAttachmentGuards(unittest.TestCase):
+    """Cases from the blind A/B rounds where line-level attachment grabbed text that is not the figure's."""
+
+    def test_label_closer_to_a_neighbouring_graphic_is_not_taken(self) -> None:
+        doc = pymupdf.open()
+        page = doc.new_page(width=612, height=792)
+        _paragraph(page, 90, 3)
+        # another plot's bare axes (an L shape: too trivial to be detected as a figure on its own)
+        page.draw_line(pymupdf.Point(60, 200), pymupdf.Point(60, 380), color=(0, 0, 0), width=0.8)
+        page.draw_line(pymupdf.Point(60, 362), pymupdf.Point(250, 362), color=(0, 0, 0), width=0.8)
+        page.insert_text((252, 374), "10", fontsize=8)  # the neighbour's last x tick value, just under its axis
+        _draw_plot(page, pymupdf.Rect(285, 200, 520, 380))
+        page.insert_text((285, 420), "Figure 3: Decay of the signal.", fontsize=BODY)
+        _paragraph(page, 450, 5)
+        boxes = [r for r in fd.collect_page_figures(page)[0] if r.x1 > 400]
+        self.assertTrue(boxes)
+        self.assertGreater(boxes[0].x0, 263, f"the neighbour's tick value must not be pulled in: {boxes[0]}")
+
+    def test_running_header_below_the_top_band_is_not_attached(self) -> None:
+        doc = pymupdf.open()
+        page = doc.new_page(width=612, height=792)
+        page.insert_text((170, 104), "CHAPTER 1.  FLUORESCENT SILICON CLUSTERS", fontsize=BODY)  # 13% from the top
+        _draw_plot(page, pymupdf.Rect(170, 118, 470, 330))
+        page.insert_text((72, 365), "Figure 1.2: Schematic of the band structure in both materials.", fontsize=BODY)
+        _paragraph(page, 395, 6)
+        box = fd.collect_page_figures(page)[0][0]
+        self.assertGreater(box.y0, 106, f"the running header (first text line of the page) must stay out: {box}")
+
+    def test_display_equation_beside_the_figure_is_not_attached(self) -> None:
+        doc = pymupdf.open()
+        page = doc.new_page(width=612, height=792)
+        _paragraph(page, 90, 3)
+        _draw_plot(page, pymupdf.Rect(72, 150, 320, 330))
+        # numerator / denominator / right-hand side of three equations, 18 pt right of the plot frame
+        # (beyond the block-level 16 pt reach, within the line-level 20 pt reach)
+        for i, y in enumerate((180, 230, 280)):
+            page.insert_text((338, y - 6), f"dQ{i}", fontsize=9)
+            page.insert_text((340, y + 6), "dt", fontsize=9)
+            page.insert_text((366, y), "= -M w p(t)", fontsize=9)
+        page.insert_text((72, 365), "Figure 2: Evolution of the moments for the three trajectories.", fontsize=BODY)
+        _paragraph(page, 395, 6)
+        box = fd.collect_page_figures(page)[0][0]
+        self.assertLess(box.x1, 337, f"the equation column must stay outside the image: {box}")
+
