# Editor defaults matching .gitattributes (LF, UTF-8). See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{cmd,bat}]
end_of_line = crlf

[*.{py,ps1}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
