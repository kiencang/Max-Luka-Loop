# Line endings: the repository and every working copy (Windows, Linux, CI) use LF,
# regardless of each machine's core.autocrlf setting.
* text=auto eol=lf

# Windows batch files must keep CRLF (cmd.exe can mis-parse labels/blocks with LF).
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings or diff them as text.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.exe binary
*.dll binary
*.pyd binary
*.onnx binary
*.zip binary
*.7z binary
*.gz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Excluded from GitHub's auto-generated "Source code" archives.
tests export-ignore
tests/** export-ignore
dev export-ignore
dev/** export-ignore
.gitattributes export-ignore
.editorconfig export-ignore
